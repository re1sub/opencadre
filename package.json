{
	"name": "vite-template-solid",
	"version": "0.0.0",
	"description": "",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"dev:supabase": "supabase start && vite",
		"build": "vite build",
		"serve": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint . --config-path ./biome.jsonc",
		"lint:full": "biome check . --config-path ./biome.jsonc",
		"lint:fix": "biome check . --write --config-path ./biome.jsonc",
		"format": "biome format . --write --config-path ./biome.jsonc",
		"prepare": "husky",
		"check:staged": "lint-staged",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/papaparse": "^5.5.2",
		"@vanilla-extract/vite-plugin": "^5.2.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"solid-devtools": "^0.34.3",
		"supabase": "^2.111.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vite-plugin-qrcode": "^0.4.1",
		"vite-plugin-solid": "^2.11.8"
	},
	"dependencies": {
		"@awesome.me/webawesome": "^3.11.0",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/solid": "^0.5.0",
		"@simple-table/solid": "^4.1.6",
		"@solidjs/router": "^1.0.0",
		"@supabase/supabase-js": "^2.110.8",
		"@tanstack/ai": "^0.52.1",
		"@tanstack/ai-client": "^0.29.2",
		"@tanstack/ai-openrouter": "^0.19.6",
		"@tanstack/ai-solid": "^0.19.4",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-bubble-menu": "^3.29.2",
		"@tiptap/extension-collaboration": "^3.31.2",
		"@tiptap/extension-collaboration-cursor": "^2.26.2",
		"@tiptap/extension-document": "^3.29.2",
		"@tiptap/extension-placeholder": "^3.30.0",
		"@tiptap/markdown": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"@vanilla-extract/css": "^1.21.1",
		"fflate": "^0.8.3",
		"marked": "^17.0.6",
		"modifiers": "link:@dnd-kit/abstract/modifiers",
		"papaparse": "^5.7.0",
		"solid-js": "^1.9.5",
		"solid-motionone": "^1.0.4",
		"y-prosemirror": "^1.3.7",
		"yjs": "^13.6.32",
		"zod": "^4.4.3"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css,html}": [
			"biome check --write --config-path ./biome.jsonc"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
