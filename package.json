{
	"name": "opencadre",
	"version": "1.11.0",
	"description": "A flexible, real-time, collaborative, and AI-powered workspace built with SolidJS for organizing ideas, projects, and knowledge.",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"dev:supabase": "supabase start && vite",
		"build": "vite build",
		"serve": "vite preview",
		"deploy": "vite build && wrangler pages deploy dist --project-name=opencadre",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint . --error-on-warnings --config-path ./biome.jsonc",
		"lint:full": "biome check . --error-on-warnings --config-path ./biome.jsonc",
		"lint:fix": "biome check . --write --config-path ./biome.jsonc",
		"format": "biome format . --write --config-path ./biome.jsonc",
		"prepare": "husky",
		"check:staged": "lint-staged",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "pnpm supabase:start && vite build --mode e2e && playwright test",
		"test:e2e:ui": "pnpm supabase:start && vite build --mode e2e && playwright test --ui",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@playwright/test": "^1.65.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.0.3",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@solidjs/testing-library": "^0.8.10",
		"@tauri-apps/cli": "^2.12.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.7",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^26.6.6",
		"@types/papaparse": "^5.5.2",
		"@vanilla-extract/vite-plugin": "^5.2.5",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"semantic-release": "^25.0.9",
		"solid-devtools": "^0.34.3",
		"supabase": "^3.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vite-plugin-qrcode": "^0.4.1",
		"vite-plugin-solid": "^2.11.8",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@awesome.me/webawesome": "^3.11.0",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/solid": "^0.5.0",
		"@simple-table/solid": "^4.1.6",
		"@solidjs/router": "^1.0.0",
		"@supabase/supabase-js": "^2.110.8",
		"@tanstack/ai": "^0.52.1",
		"@tanstack/ai-client": "^0.29.2",
		"@tanstack/ai-openrouter": "^0.19.6",
		"@tanstack/ai-solid": "^0.19.4",
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-bubble-menu": "^3.35.0",
		"@tiptap/extension-collaboration": "^3.35.0",
		"@tiptap/extension-collaboration-cursor": "^3.0.0",
		"@tiptap/extension-placeholder": "^3.35.0",
		"@tiptap/markdown": "^3.35.0",
		"@tiptap/pm": "^3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"@vanilla-extract/css": "^1.21.1",
		"dompurify": "^3.5.0",
		"fflate": "^0.8.3",
		"lucide-static": "^1.81.0",
		"marked": "^17.0.6",
		"modifiers": "link:@dnd-kit/abstract/modifiers",
		"papaparse": "^5.7.0",
		"solid-js": "^1.9.20",
		"solid-motionone": "^1.0.4",
		"y-prosemirror": "^1.3.7",
		"yjs": "^13.6.32",
		"zod": "^4.6.7"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css,html}": [
			"biome check --write --error-on-warnings --config-path ./biome.jsonc"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			[
				"@semantic-release/exec",
				{
					"prepareCmd": "node scripts/sync-release-version.mjs ${nextRelease.version}"
				}
			],
			[
				"@semantic-release/git",
				{
					"assets": [
						"CHANGELOG.md",
						"package.json",
						"src-tauri/Cargo.toml",
						"src-tauri/Cargo.lock",
						"src-tauri/tauri.conf.json"
					],
					"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
				}
			],
			"@semantic-release/github"
		]
	}
}
