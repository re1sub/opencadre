# OpenCadre self-hosting configuration. Docker Compose reads only this file.
# Vite exposes VITE_* and SUPABASE_PUBLIC*/SUPABASE_PUBLISHABLE* to the browser;
# secrets are never exposed. Changing a public value requires a rebuild.

# App and gateway ports
APP_PORT=3000
API_GW_HTTP_PORT=8000
STUDIO_PORT=3001
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# Public URLs. Set both to https://<PROXY_DOMAIN> when using the proxy profile.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
PROXY_DOMAIN=example.com

# Generated keys. Run `docker compose run --rm setup` before the first build.
# setup also writes public values to docker/app/build.env for Vite.
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME
JWT_KEYS=CHANGE_ME
JWT_JWKS=CHANGE_ME
ANON_KEY_ASYMMETRIC=CHANGE_ME
SERVICE_ROLE_KEY_ASYMMETRIC=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME
REALTIME_DB_ENC_KEY=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME

# Dashboard (served by the API gateway at http://localhost:8000)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME

# Database and pooler
POSTGRES_HOST=db
POSTGRES_DB=postgres
POOLER_TENANT_ID=opencadre
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# Auth
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
ENABLE_EMAIL_SIGNUP=true
# No SMTP server is configured by default, so new accounts are confirmed immediately.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Email delivery. Leave SMTP_HOST empty to disable outgoing mail.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=OpenCadre
SMTP_FROM=
SMTP_FROM_NAME=OpenCadre

# Google sign-in. Also set VITE_ENABLE_GOOGLE_SIGNIN=true.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Edge functions
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=2g
OPENROUTER_API_KEY=

# Studio (optional profile)
STUDIO_DEFAULT_ORGANIZATION=OpenCadre
STUDIO_DEFAULT_PROJECT=Self-hosted
OPENAI_API_KEY=

# API and Studio defaults
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Optional frontend features. Defaults preserve hosted behavior when absent.
VITE_ENABLE_GOOGLE_SIGNIN=false
VITE_ENABLE_AI=false
VITE_ENABLE_MEMBER_INVITES=false
VITE_ENABLE_LEGAL_PAGES=false
VITE_ENABLE_GITHUB_RELEASE_CHECK=false
VITE_ENABLE_CDN_ICONS=false
