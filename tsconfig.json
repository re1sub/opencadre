{
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,

		// Type Checking & Safety
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client"],

		"paths": {
			"#/*": ["./src/*"],
			"#components/*": ["./src/components/*"],
			"#utils/*": ["./src/utils/*"],
			"#pages/*": ["./src/pages/*"],
			"#styles/*": ["./src/styles/*"],
			"#theme/*": ["./src/theme/*"]
		}
	},
	"include": ["src", "src/**/*.css"]
}
