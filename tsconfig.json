{
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,

		// Type Checking & Safety
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client", "@testing-library/jest-dom"],

		"paths": {
			"#/*": ["./src/*"],
			"#styles/*": ["./src/styles/*"],
			"#theme/*": ["./src/theme/*"],
			"#assets/*": ["./src/assets/*"]
		}
	},
	"include": ["src", "src/**/*.css"]
}
